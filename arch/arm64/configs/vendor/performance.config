# Performance & Custom Features Configuration
# CPU Governors - Add more options for user control
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y

# I/O Schedulers - Multiple options
CONFIG_IOSCHED_NOOP=y
CONFIG_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_CFQ=y
CONFIG_CFQ_GROUP_IOSCHED=y
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y

# TCP Congestion Control
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y

# WireGuard VPN
CONFIG_WIREGUARD=m
CONFIG_WIREGUARD_DEBUG=n

# ExFAT support
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"

# F2FS optimizations
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_CHECK_FS=y

# Performance optimizations
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set

# LTO (Link Time Optimization) - Already enabled
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y

# Kernel compression
CONFIG_KERNEL_LZ4=y

# CPU Power management
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_LADDER=y
CONFIG_CPU_IDLE_GOV_MENU=y

# Network optimizations
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=m

# Boeffla Wakelock Blocker (battery saver)
CONFIG_BOEFFLA_WL_BLOCKER=y

# Sound control
CONFIG_SOUND_CONTROL=y

# KSM (Kernel Same-page Merging) for memory optimization
CONFIG_KSM=y

# zRAM optimizations
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZSMALLOC=y
CONFIG_ZSMALLOC_STAT=y

# NTFS support (read-only safe, read-write optional)
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y

# USB tethering optimizations
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y

# Advanced networking
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y

# Power efficient workqueues
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# Debug disabled for performance
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_PREEMPT is not set
