# HINA Kernel - Enhanced Performance Features Configuration
# Version: 1.0
# Built for SM8250 (Kona) Devices

# ============================================================================
# CPU & Performance Governors
# ============================================================================
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_BOOST=y
CONFIG_CPU_FREQ_STAT=y

# CPU Idle Optimization
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_LADDER=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_CPU_IDLE_MULTIPLE_DRIVERS=y

# CPU Power Management
CONFIG_CPUFREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_STATS=y
CONFIG_HAVE_CLK_PREPARE_PARENT=y

# ============================================================================
# I/O Schedulers - Multiple Options
# ============================================================================
CONFIG_IOSCHED_NOOP=y
CONFIG_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_CFQ=y
CONFIG_CFQ_GROUP_IOSCHED=y
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y

# I/O Performance
CONFIG_BLK_DEV_INTEGRITY_T10=y
CONFIG_BLK_MQ_PCI=y

# ============================================================================
# TCP Congestion Control & Network
# ============================================================================
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y
CONFIG_TCP_CONG_VEGAS=y
CONFIG_TCP_CONG_SCALABLE=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_TCP_MD5SIG=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y

# Network Queue Disciplines
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=m
CONFIG_NET_SCH_PFIFO_FAST=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_INGRESS=y

# ============================================================================
# VPN & Security Modules
# ============================================================================
# WireGuard VPN - Modern VPN Protocol
CONFIG_WIREGUARD=m
CONFIG_WIREGUARD_DEBUG=n

# TUN/TAP Support
CONFIG_TUN=y
CONFIG_TAP=y

# IPSec
CONFIG_XFRM=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_ALGO=y

# ============================================================================
# Filesystem Support
# ============================================================================
# ExFAT - Modern FAT variant
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_EXFAT_DEFAULT_CODEPAGE=437

# NTFS - Windows filesystem
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y
CONFIG_NTFS_DEBUG=n

# F2FS Optimizations
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_CHECK_FS=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_F2FS_FAULT_INJECTION=n
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_LZ4_COMPRESS=y
CONFIG_F2FS_FS_ZSTD_COMPRESS=y

# EXT4 Enhancements
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_FS_ENCRYPTION=y

# ============================================================================
# Memory & Compression
# ============================================================================
# zRAM - Memory compression
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MEMORY_TRACKING=y
CONFIG_ZSMALLOC=y
CONFIG_ZSMALLOC_STAT=y
CONFIG_ZSMALLOC_MAX_ZSPAGE_ORDER=1

# KSM - Kernel Same-page Merging
CONFIG_KSM=y
CONFIG_KSM_DEFRAG=y

# LZ4 Compression
CONFIG_KERNEL_LZ4=y
CONFIG_CRYPTO_LZ4=y

# ZSTD Compression
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y

# ============================================================================
# Performance Optimizations
# ============================================================================
# Compiler Optimizations
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set

# Link Time Optimization (already enabled in base config)
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y
CONFIG_LTO_CLANG_THIN=y

# Power Efficiency
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y

# Preemption & Latency
CONFIG_PREEMPT=y
CONFIG_PREEMPT_COUNT=y
CONFIG_PREEMPT_RCU=y

# ============================================================================
# Battery & Power Management
# ============================================================================
# Boeffla Wakelock Blocker
CONFIG_BOEFFLA_WL_BLOCKER=y

# Power Efficient features
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_HAVE_EFFICIENT_UNALIGNED_ACCESS=y

# USB Fast Charging (if supported by device)
CONFIG_USB_SUSPEND=y
CONFIG_PM_RUNTIME=y

# ============================================================================
# Audio & Multimedia
# ============================================================================
# Sound Control
CONFIG_SOUND_CONTROL=y
CONFIG_SND_SOC=y
CONFIG_SND_COMPRESS_OFFLOAD=y

# Audio codec support
CONFIG_SND_SOC_COMPRESS=y
CONFIG_SND_JACK=y

# ============================================================================
# Touchscreen & Input Optimizations
# ============================================================================
CONFIG_TOUCH_BOOST=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SYNAPTICS=y

# ============================================================================
# GPU & Rendering
# ============================================================================
CONFIG_SYNC=y
CONFIG_SW_SYNC=y
CONFIG_SW_SYNC_USER=y

# ============================================================================
# USB & Charging
# ============================================================================
# USB Tethering
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_GADGET_MASS_STORAGE=y

# USB OTG
CONFIG_USB_OTG=y
CONFIG_USB_OTG_WAKELOCK=y

# Charging optimizations
CONFIG_CHARGER_MANAGER=y
CONFIG_POWER_SUPPLY=y

# ============================================================================
# Module & Driver Support
# ============================================================================
# Loadable modules
CONFIG_MODULES=y
CONFIG_MODULE_SRCORDER=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y

# ============================================================================
# Debugging & Profiling (Disabled for Performance)
# ============================================================================
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_SG is not set
# CONFIG_DEBUG_NOTIFIERS is not set
# CONFIG_DEBUG_CREDENTIALS is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_RCU_TRACE is not set
# CONFIG_PRINTK_TIME is not set

# ============================================================================
# Kernel Security & Hardening
# ============================================================================
# SELinux - Already configured by rom
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y

# File integrity
CONFIG_IMA=y
CONFIG_IMA_APPRAISE=y

# ============================================================================
# Cache & Memory Optimizations
# ============================================================================
CONFIG_SYN_COOKIES=y
CONFIG_NET_IPVS=y
CONFIG_SWAP=y
CONFIG_SWAPFILE=y
CONFIG_PAGE_COUNTER=y

# ============================================================================
# Advanced Networking Features
# ============================================================================
CONFIG_NETFILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_TABLES=y

# ============================================================================
# Kernel Features for Root Solutions
# ============================================================================
# Required for KernelSU/Magisk
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KRETPROBES=y

# ============================================================================
# HINA Kernel Custom Settings
# ============================================================================
# Ultra-responsive input
CONFIG_TIMER_FREQ=1000

# Better thermal management
CONFIG_THERMAL=y
CONFIG_THERMAL_HWMON=y
CONFIG_THERMAL_GOV_FAIR_SHARE=y
CONFIG_THERMAL_GOV_STEP_WISE=y

# Paranoid about Kernel
# CONFIG_PANIC_ON_WARN is not set
# CONFIG_BUG_ON_DATA_CORRUPTION is not set

